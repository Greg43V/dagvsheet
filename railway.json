{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "gunicorn 'website:create_website()' --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 90 --error-logfile - --access-logfile /dev/null --no-control-socket",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
